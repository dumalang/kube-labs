{
	"info": {
		"_postman_id": "b1a2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
		"name": "Kubernetes Microservices Lab API Collection",
		"description": "Postman Collection to test Node.js, Golang, Java Spring Boot REST APIs and NGINX Ingress Routing rules in the Kubernetes local cluster.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost",
			"type": "string",
			"description": "Base URL pointing to NGINX Ingress Controller on localhost:80 (or localhost:8080 if port-forwarded)"
		}
	],
	"item": [
		{
			"name": "Node.js Service (service-a-nodejs)",
			"item": [
				{
					"name": "Get Node.js Info",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response contains service name', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.service).to.eql('service-a-nodejs');",
									"    pm.expect(jsonData.language).to.eql('Node.js');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/nodejs/info",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"nodejs",
								"info"
							]
						},
						"description": "Fetches service info, environment from ConfigMap, secret status, and hostname of Node.js pod replica."
					},
					"response": []
				},
				{
					"name": "Call Golang via K8s Internal DNS",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Inter-service communication succeeded', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.calledUrl).to.include('service-b-golang');",
									"    pm.expect(jsonData.golangResponse).to.have.property('products');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/nodejs/call-golang",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"nodejs",
								"call-golang"
							]
						},
						"description": "Triggers Node.js service to perform an HTTP request to Golang service inside K8s cluster using internal DNS."
					},
					"response": []
				},
				{
					"name": "Node.js Healthcheck (Liveness Probe)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Status is HEALTHY', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('HEALTHY');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/nodejs/healthz",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"nodejs",
								"healthz"
							]
						},
						"description": "Liveness probe endpoint used by Kubernetes."
					},
					"response": []
				}
			]
		},
